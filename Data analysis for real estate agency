-- Добавляем категоризацию на Лен обл и С-П
category_date as
(select CASE 
        WHEN c.city LIKE 'Санкт-Петербург' THEN 'Санкт-Петербург'
        ELSE 'ЛенОбл'
    END AS "Регион",
	    CASE 
		    WHEN days_exposition between 1 and 30
			THEN 'до месяца'
			WHEN days_exposition between 31 and 90
			THEN 'до трех месяцев'
			WHEN days_exposition between 91 and 180
			THEN 'до полугода'
			ELSE 'более полугода'
			end as "Сегмент активности",
			count(id) as "Количество объявлений",
			AVG(a.last_price/fd.total_area) as "Средняя стоимость кв. метра",
			AVG(fd.total_area) as "Средняя площадь",
			AVG(kitchen_area) as "Средняя площадь кухни",
			percentile_disc(0.5) within group (order by rooms) as "Медиана количества комнат",
			percentile_disc(0.5) within group (order by balcony) as "Медиана количества балконов",
			percentile_disc(0.5) within group (order by floor) as "Медиана этажности",
			AVG(ceiling_height) as "Средняя высота потолка",
			sum(case when fd.open_plan=1 then 1 else 0 end)/count(id)::float as "Доля квартир-студий",
			count(id)/SUM(count(id)) OVER () AS "Доля проданных объявлений"
from filtered_data as fd
left join real_estate.city as c using (city_id)
left join real_estate.advertisement as a using (id)
left join real_estate.type as t using (type_id)
where type_id='F8EM' -->фильтр на года по просьбе ревьювера
group by  "Регион","Сегмент активности"
order by "Доля проданных объявлений" desc
)
select*,
		"Количество объявлений"/sum("Количество объявлений") over (partition by "Регион") as "Доля объявлений в группе",
		"Количество объявлений"/sum("Количество объявлений") over () as "Общая доля объявлений",
		sum("Количество объявлений") over (partition by "Регион")/sum("Количество объявлений") over ()  as "Доля группы в общем объеме"
from category_date


